#!/bin/bash

# Homebrew
if [[ -z "$HOMEBREW_PREFIX" ]]; then
    if [[ -x "$HOME"/.linuxbrew/bin/brew ]]; then
        eval "$("$HOME"/.linuxbrew/bin/brew shellenv)"
    else
        [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    fi
fi

# Activate asdf if mise not present
if ! type -P mise &>/dev/null; then
    # Activate asdf if present
    if [[ -d $HOME/.asdf ]]; then
        export ASDF_FORCE_PREPEND=yes
        pathmunge ~/.asdf/shims
    fi
fi

# Add DISPLAY environment to DBUS
if [[ -x /usr/bin/dbus-update-activation-environment &&
          -n $DBUS_SESSION_BUS_ADDRESS &&
          -n $DISPLAY ]]; then
    /usr/bin/dbus-update-activation-environment --systemd DISPLAY
fi
